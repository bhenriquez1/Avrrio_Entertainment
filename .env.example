# Avrrio Entertainment — environment variables
# Copy to .env.local and fill in values before running.

# AI Providers (server-side only — never exposed to browser)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o
RUNWAY_API_KEY=
KLING_API_KEY=
ELEVENLABS_API_KEY=
BLENDER_WORKER_URL=
BLENDER_WORKER_TOKEN=

# Feature flags
NEXT_PUBLIC_GUEST_MODE=false
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# Firebase (client-side, used for Auth + Firestore persistence)
# Required. Avrrio requires Firebase Authentication to be configured —
# there is no public or anonymous access. Without these set, the app shows
# a "Setup Required" screen instead of any dashboard content.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional. Enables Firebase Analytics in the browser only; safe to leave unset.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server-only, used to verify ID tokens)
# Generate a service account key from Firebase Console > Project Settings > Service Accounts.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Access control (server-only). Comma-separated email addresses.
# Accounts that sign up but are not listed here see "This beta is currently invite-only."
# Owner emails get full admin/owner access and do not also need to be listed in ALLOWED_EMAILS.
ALLOWED_EMAILS=
OWNER_EMAILS=

# Site-wide password gate (edge middleware, optional). When SITE_PASSWORD is
# set, every request — including API routes — must pass HTTP Basic Auth with
# this username/password before reaching the app at all. Leave unset to disable.
SITE_PASSWORD_USERNAME=avrrio
SITE_PASSWORD=

# Signs the session cookie that proxy.ts (the edge route guard) checks for
# protected pages and /api/*. Required for real auth enforcement to work.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Server-only. Must be set alongside NEXT_PUBLIC_DEV_BYPASS_AUTH to let the
# bypass take effect in a production build.
ALLOW_PRODUCTION_DEV_BYPASS=
